# Optional. Copy this file to .env in this folder. No keys needed for demo mode.
PORT=4000
HOST=127.0.0.1
# Use an Azure resource root, e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Supported chat-completion deployment; the v1 API is used.
AZURE_OPENAI_TIMEOUT_MS=8000
# Relative paths resolve from the project root. Use one server per data directory.
DATA_DIR=runtime
# Set false for an empty initial invoice feed. Vendor fingerprints always load.
SEED_DEMO=true
